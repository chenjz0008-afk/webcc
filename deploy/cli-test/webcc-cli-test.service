[Unit]
Description=Isolated server Claude Code test terminal
After=docker.service clewdr-manager.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/opt/webcc-cli-test/ttyd -i 127.0.0.1 -p 7681 -W -O -m 1 -b /claude-test /var/lib/webcc-cluster/venv/bin/python /opt/webcc-cli-test/launch.py
RuntimeMaxSec=86400
Restart=no
UMask=0077

[Install]
WantedBy=multi-user.target
