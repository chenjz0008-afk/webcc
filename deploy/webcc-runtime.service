[Unit]
Description=WebCC durable tasks worker
After=clewdr-manager.service
Requires=clewdr-manager.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/clewdr-manager
EnvironmentFile=/etc/clewdr-manager.env
ExecStart=/var/lib/webcc-cluster/venv/bin/python -m runtime_queue
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=96M
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
