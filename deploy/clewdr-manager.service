[Unit]
Description=ClewdR account container manager and API gateway
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/clewdr-manager
EnvironmentFile=/etc/clewdr-manager.env
ExecStart=/usr/bin/python3 /opt/clewdr-manager/serve.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/clewdr-manager
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
MemoryMax=256M
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
