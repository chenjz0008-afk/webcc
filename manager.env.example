MANAGER_BIND=127.0.0.1
MANAGER_PORT=9000
MANAGER_DATA=/var/lib/clewdr-manager
MANAGER_IMAGE=ghcr.io/xerxes-2/clewdr:v0.13.5
MANAGER_WEB_TOOLS_ENABLED=false
MANAGER_PROXY_ONLY=true
MANAGER_MAX_INFLIGHT=4
MANAGER_QUEUE_SIZE=16
MANAGER_QUEUE_SECONDS=15
MANAGER_RETRY_ATTEMPTS=3
MANAGER_FAILURE_THRESHOLD=3
MANAGER_REQUEST_SECONDS=150
MANAGER_WORKER_SECONDS=60
MANAGER_FILE_MAX_BYTES=20971520
MANAGER_FILES_PER_KEY=128
MANAGER_FILES_OWNER_BYTES=268435456
MANAGER_FILES_TOTAL_BYTES=1073741824
MANAGER_FILE_DEFAULT_TTL_SECONDS=0
MANAGER_TOOL_REQUEST_MAX_BYTES=33554432
MANAGER_ATTACHMENT_MAX_COUNT=16
MANAGER_MEDIA_MAX_INFLIGHT=2
MANAGER_UPDATE_SECONDS=86400
MANAGER_FOLLOW=master
MANAGER_AUTO_UPDATE=true
CLEWDR_PASSWORD=replace-with-a-strong-api-password
CLEWDR_ADMIN_PASSWORD=replace-with-a-different-admin-password

# Shared state. Both URLs are required for cluster mode; secrets stay outside Git.
MANAGER_DATABASE_URL=
MANAGER_REDIS_URL=
MANAGER_NODE_ID=node-1

# Durable tools require PostgreSQL, an installed queue schema and webcc-runtime.service.
MANAGER_RUNTIME_ENABLED=false
E2B_API_KEY=
MANAGER_E2B_PROXY=
MANAGER_E2B_TEMPLATE=base
